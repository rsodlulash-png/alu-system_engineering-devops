#!/usr/bin/env bash
# Configures a brand new Ubuntu machine so that Nginx adds a custom
# X-Served-By header containing the hostname of the server answering.

sudo apt-get update
sudo apt-get install -y nginx

# Put the header in the http context (conf.d is included there), so it applies to
# every site regardless of which site file is enabled.
# $hostname is a built-in Nginx variable, so the same script works on web-01 and web-02.
echo 'add_header X-Served-By $hostname;' | sudo tee /etc/nginx/conf.d/custom_header.conf > /dev/null

# Validate the configuration, then restart Nginx
sudo nginx -t
sudo service nginx restart
