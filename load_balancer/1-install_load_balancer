#!/usr/bin/env bash
# Installs and configures HAProxy on lb-01 to round-robin traffic to web-01 and web-02

# Replace these with your own server IPs
WEB_01_IP="18.170.29.94"
WEB_02_IP="18.130.92.32"

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
	SUDO="sudo"
fi

# Install HAProxy
$SUDO apt-get update -y
$SUDO apt-get install -y haproxy

# Allow HAProxy to be managed via its init script
echo "ENABLED=1" | $SUDO tee /etc/default/haproxy > /dev/null

# Add the load balancer configuration (only once)
if ! grep -q "web-backend" /etc/haproxy/haproxy.cfg; then
	$SUDO tee -a /etc/haproxy/haproxy.cfg > /dev/null << EOF

frontend web-frontend
    bind *:80
    mode http
    default_backend web-backend

backend web-backend
    mode http
    balance roundrobin
    server web-01 $WEB_01_IP:80 check
    server web-02 $WEB_02_IP:80 check
EOF
fi

# Validate the configuration and restart via the init script
$SUDO haproxy -c -f /etc/haproxy/haproxy.cfg
$SUDO service haproxy restart
